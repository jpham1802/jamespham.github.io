{
  "manifest_version": 3,
  "name": "SEO Audit Tool",
  "version": "1.0.0",
  "description": "Instant on-page SEO insights for website auditing",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
